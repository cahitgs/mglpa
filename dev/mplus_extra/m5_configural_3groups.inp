TITLE: m5_configural_3groups
DATA: FILE IS wm3.dat;
VARIABLE:
  NAMES = id group group3 verbal_m visual_m updating inhibitn proc_spd educatin
    cog_rese task_pef everydac;
  USEVARIABLES = verbal_m visual_m updating inhibitn proc_spd;
  KNOWNCLASS = cg (group3 = 1 group3 = 2 group3 = 3);
  CLASSES = cg (3) c (3);

ANALYSIS:
  TYPE = MIXTURE;
  ESTIMATOR = MLR;
  STARTS = 1000 100;
  STITERATIONS = 20;
  PROCESSORS = 8;

MODEL:
  %OVERALL%
  c#1 on cg#1 cg#2;
  c#2 on cg#1 cg#2;
  %cg#1.c#1%
  [verbal_m visual_m updating inhibitn proc_spd] (m1_1_1-m1_1_5);
  verbal_m visual_m updating inhibitn proc_spd (vg1_1-vg1_5);
  %cg#1.c#2%
  [verbal_m visual_m updating inhibitn proc_spd] (m1_2_1-m1_2_5);
  verbal_m visual_m updating inhibitn proc_spd (vg1_1-vg1_5);
  %cg#1.c#3%
  [verbal_m visual_m updating inhibitn proc_spd] (m1_3_1-m1_3_5);
  verbal_m visual_m updating inhibitn proc_spd (vg1_1-vg1_5);
  %cg#2.c#1%
  [verbal_m visual_m updating inhibitn proc_spd] (m2_1_1-m2_1_5);
  verbal_m visual_m updating inhibitn proc_spd (vg2_1-vg2_5);
  %cg#2.c#2%
  [verbal_m visual_m updating inhibitn proc_spd] (m2_2_1-m2_2_5);
  verbal_m visual_m updating inhibitn proc_spd (vg2_1-vg2_5);
  %cg#2.c#3%
  [verbal_m visual_m updating inhibitn proc_spd] (m2_3_1-m2_3_5);
  verbal_m visual_m updating inhibitn proc_spd (vg2_1-vg2_5);
  %cg#3.c#1%
  [verbal_m visual_m updating inhibitn proc_spd] (m3_1_1-m3_1_5);
  verbal_m visual_m updating inhibitn proc_spd (vg3_1-vg3_5);
  %cg#3.c#2%
  [verbal_m visual_m updating inhibitn proc_spd] (m3_2_1-m3_2_5);
  verbal_m visual_m updating inhibitn proc_spd (vg3_1-vg3_5);
  %cg#3.c#3%
