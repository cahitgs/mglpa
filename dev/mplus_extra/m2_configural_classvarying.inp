TITLE: m2_configural_classvarying
DATA: FILE IS wm3.dat;
VARIABLE:
  NAMES = id group group3 verbal_m visual_m updating inhibitn proc_spd educatin
    cog_rese task_pef everydac;
  USEVARIABLES = verbal_m visual_m updating inhibitn proc_spd;
  KNOWNCLASS = cg (group = 1 group = 2);
  CLASSES = cg (2) c (3);

ANALYSIS:
  TYPE = MIXTURE;
  ESTIMATOR = MLR;
  STARTS = 1000 100;
  STITERATIONS = 20;
  PROCESSORS = 8;

MODEL:
  %OVERALL%
  c#1 on cg#1;
  c#2 on cg#1;
  %cg#1.c#1%
  [verbal_m visual_m updating inhibitn proc_spd] (m1_1_1-m1_1_5);
  verbal_m visual_m updating inhibitn proc_spd (v1_1_1-v1_1_5);
  %cg#1.c#2%
  [verbal_m visual_m updating inhibitn proc_spd] (m1_2_1-m1_2_5);
  verbal_m visual_m updating inhibitn proc_spd (v1_2_1-v1_2_5);
  %cg#1.c#3%
  [verbal_m visual_m updating inhibitn proc_spd] (m1_3_1-m1_3_5);
  verbal_m visual_m updating inhibitn proc_spd (v1_3_1-v1_3_5);
  %cg#2.c#1%
  [verbal_m visual_m updating inhibitn proc_spd] (m2_1_1-m2_1_5);
  verbal_m visual_m updating inhibitn proc_spd (v2_1_1-v2_1_5);
  %cg#2.c#2%
  [verbal_m visual_m updating inhibitn proc_spd] (m2_2_1-m2_2_5);
  verbal_m visual_m updating inhibitn proc_spd (v2_2_1-v2_2_5);
  %cg#2.c#3%
  [verbal_m visual_m updating inhibitn proc_spd] (m2_3_1-m2_3_5);
  verbal_m visual_m updating inhibitn proc_spd (v2_3_1-v2_3_5);

OUTPUT: TECH1;
